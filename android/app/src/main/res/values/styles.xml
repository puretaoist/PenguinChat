<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is off -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12+ 的系统启动画面：官方 QQ 用 windowDisablePreview=true
             把预览整屏关掉，Flutter 侧没有对应 API，只能做到"底色与首帧同色"。
             图标显式设为透明 —— 不加 logo/气泡，产品要求启动就是一块干净的
             暗色，直接进列表（不加图形反而不会有"闪一下图标再闪一下"的跳变）。 -->
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <!-- edge-to-edge：状态栏 / 导航栏一律不上色，颜色交给 Flutter 画
             （官方 messenger/AndroidUtilities.java:6807-6831 enableEdgeToEdge）。
             这是"系统栏实色块"的根源：不写这几项时取 Theme 默认的
             colorPrimaryDark，页面顶到屏幕顶端后就会露出那条实色。
             图标固定白色 —— 启动底色 launch_background=#0F0F0F 是深色，
             Flutter 起来后由 HomeShell 的 AnnotatedRegion 按主题接管。 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <!-- edge-to-edge：状态栏 / 导航栏一律不上色，颜色交给 Flutter 画
             （官方 messenger/AndroidUtilities.java:6807-6831 enableEdgeToEdge）。
             这是"系统栏实色块"的根源：不写这几项时取 Theme 默认的
             colorPrimaryDark，页面顶到屏幕顶端后就会露出那条实色。
             图标固定白色 —— 启动底色 launch_background=#0F0F0F 是深色，
             Flutter 起来后由 HomeShell 的 AnnotatedRegion 按主题接管。 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
