# ---- 本项目补充 ----
# Flutter 工具本机状态（不含项目信息，不应入库）
/.flutter_tool_state
# 本机路径文件（绝对路径不能在 CI 上复用，由工作流动态生成）
/android/local.properties
# Gradle 各类中间产物 / 日志 / 独立 GRADLE_USER_HOME
/android/.gradle/
/.gradle-build/
/.gradle/
*.lock
# 反编译产物与逆向分析中间文件（体积大，不入库）
/analysis-out/
*.apk
*.dex
!android/gradle/wrapper/gradle-wrapper.jar

# Rust 构建产物（协议内核移植）；但 Cargo.lock 要入库（可复现）
/rust/target/
!rust/Cargo.lock

# 调试输出（临时抓的测试日志）
ui_out.txt
ui2.txt
*_out.txt

# 逆向调试的一次性探针（不进主树；结论已写进 docs/PITFALLS.md）
/tool/tmp/

# 第三方 IDE 生成的计划文档（不属于本仓库内容）
/.trae/
device-logcat.txt
test/failures/

# 真机导出的 A1 材料（含凭证，绝不入库）
a1_*.json

# 一次性实验：TIM native 安全库与批处理输入（体积大、非我方所有，不入库）
