# ---- 本项目补充 ----
# Flutter 工具本机状态（不含项目信息，不应入库）
/.flutter_tool_state
# 本机路径文件（绝对路径不能在 CI 上复用，由工作流动态生成）
/android/local.properties
# Gradle 各类中间产物 / 日志 / 独立 GRADLE_USER_HOME
/android/.gradle/
/.gradle-build/
/.gradle/
*.lock
# 反编译产物与逆向分析中间文件（体积大，不入库）
/analysis-out/
*.apk
*.dex
!android/gradle/wrapper/gradle-wrapper.jar

# 调试输出（临时抓的测试日志）
ui_out.txt
ui2.txt
*_out.txt

# 协议分析：反编译与提取产物（可在本地重建，不进库，共约 645MB）
analysis/_decompiled/

# 真机取证（含账号信息，绝不入库）
analysis/_device-dump/

# 协议分析：从 APK 抽出的腾讯原生库。
# 本地留着供查阅，但**不入公共仓库**——它们是腾讯的专有二进制，
# 提交即构成再分发。需要时按 analysis/README.md 从 APK 重新抽取。
analysis/lib/
